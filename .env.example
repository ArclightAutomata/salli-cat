# 2captcha API key for automatic CAPTCHA solving (optional)
# Get your API key from: https://2captcha.com/enterpage
# If not set, captchas will require manual solving in the browser window
# TWOCAPTCHA_API_KEY=your_api_key_here

# Proxy settings (optional - works with Decodo, Oxylabs, Bright Data, or any HTTP proxy)
# Used for browser requests when use_proxy: true in config.yaml
#
# Either set a single PROXY_URL (takes precedence):
# PROXY_URL=http://username:password@gate.decodo.com:7000
# ...or the individual variables:
# PROXY_HOST=pr.oxylabs.io
# PROXY_PORT=7777
# PROXY_USER=your_username
# PROXY_PASS=your_password
#
# IP rotation: a {session} placeholder in the username is replaced with a random
# session ID at each browser launch, and the manualslib scraper relaunches the
# browser with a fresh session (forcing a new exit IP) after each failed
# download, so the circuit breaker only trips if several different IPs fail.
# Provider username formats:
#   Decodo:      user-USERNAME-session-{session}          (gate.decodo.com:7000)
#   Oxylabs:     customer-USERNAME-sessid-{session}
#   Bright Data: brd-customer-ID-zone-ZONE-session-{session}
# Example:
# PROXY_URL=http://user-USERNAME-session-{session}:password@gate.decodo.com:7000

# Internet Archive uploads (--upload-to-ia)
# Credentials are stored in ~/.config/internetarchive/ia.ini
# Run `ia configure` to set up, or create the file manually:
#   [s3]
#   access = YOUR_ACCESS_KEY
#   secret = YOUR_SECRET_KEY
# Get your keys at: https://archive.org/account/s3.php
